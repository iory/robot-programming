<?xml version="1.0"?>
<robot name="simple_box">
  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="1.0 1.0 1.0"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="1.0 1.0 1.0"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.166" ixy="0.0" ixz="0.0" iyy="0.166" iyz="0.0" izz="0.166"/>
    </inertial>
  </link>
</robot>